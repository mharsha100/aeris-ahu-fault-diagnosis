    },
    {
      "title": "Adaptation lifecycle",
      "url": "/d/aeris-learning",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": false
    }
  ],
  "timepicker": {
    "hidden": true
  }
}