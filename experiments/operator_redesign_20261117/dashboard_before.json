{
  "uid": "aeris-operations",
  "title": "AERIS \u00b7 Operations, review & model evidence",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "AERIS",
    "EGN6216"
  ],
  "templating": {
    "list": [
      {
        "name": "cohort",
        "type": "custom",
        "query": "test,genuine",
        "current": {
          "text": "test",
          "value": "test"
        },
        "options": [
          {
            "text": "test",
            "value": "test",
            "selected": true
          },
          {
            "text": "genuine",
            "value": "genuine",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 25,
      "type": "text",
      "title": "AERIS / operational command view",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Actual requests, durable feedback, explicit cohorts.**\n\nSelect **test** for the professor demonstration or **genuine** for real operator records. Diagnose a window in AERIS to generate measured traffic. No synthetic production outcomes are inserted."
      }
    },
    {
      "id": 26,
      "type": "text",
      "title": "Read missing values correctly",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**No recent requests** \u2192 latency has no five-minute sample.\n\n**No ratings / agreement responses** \u2192 the denominator is zero.\n\n**No inspected labels** \u2192 live accuracy is not measured. Counts below show the support; offline model scores are in AERIS \u2192 Model evidence."
      }
    },
    {
      "id": 1,
      "title": "Model readiness",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aeris-prometheus"
      },
      "targets": [
        {
          "expr": "aeris_model_ready",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples received",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNAVAILABLE",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "description": "Actual persisted service measurements for the selected cohort. Test and genuine operator records are separate."
    },
