    {
      "id": 5,
      "title": "Inference p50 (service)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aeris-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by(le)(rate(aeris_inference_seconds_bucket{cohort=\"$cohort\"}[5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No requests in the last 5 min",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "description": "Inference service duration, seconds. Empty when there are no requests in the five-minute rate window. Browser latency is measured separately."
    },
    {
      "id": 6,
      "title": "Inference p95 (service)",
      "type": "stat",
